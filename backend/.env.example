# Server Configuration
PORT=8086
SPRING_APPLICATION_NAME=gully-cricket-backend

# MongoDB Connection
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/gulli_cricket?retryWrites=true&w=majority&appName=Gulli-Cricket
SPRING_DATA_MONGODB_AUTO_INDEX_CREATION=true

# HTTP Compression
SERVER_COMPRESSION_ENABLED=true
SERVER_COMPRESSION_MIME_TYPES=text/html,text/xml,text/plain,text/css,text/javascript,application/javascript,application/json
SERVER_COMPRESSION_MIN_RESPONSE_SIZE=1024

# JWT Security
JWT_SECRET=YourSuperSecretKeyForAuthenticationSigningKey2026!
JWT_EXPIRATION=86400000

# Logging
LOGGING_LEVEL_COM_GULLYCRICKET=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_DATA_MONGODB=INFO
